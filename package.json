{
  "name": "linkforge",
  "version": "1.0.0",
  "description": "Production URL shortener and bio link platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "email:dev": "pnpm --filter api email:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.yml down",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@neon/config": "^1.7.0",
    "@neon/env": "^1.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
